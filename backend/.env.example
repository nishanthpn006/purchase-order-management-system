# ==============================================================================
# Purchase Order Management System (POMS) - Backend Environment Variables
# Copy this file to .env and provide your local credentials.
# NEVER commit .env or actual secret values to source control.
# ==============================================================================

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/purchase_order_db?currentSchema=public
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# JWT Configuration (Secret must be at least 256 bits / 32 characters)
JWT_SECRET=your_secure_jwt_signing_secret_at_least_256_bits_here
JWT_EXPIRATION=86400000

# CORS Configuration (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173
